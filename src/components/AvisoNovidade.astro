---
import { dataCurta, dataISO } from '../lib/formato';
import { novidadesOrdenadas } from '../lib/novidades';

/**
 * Aviso discreto de novidade para quem VOLTA ao site.
 *
 * Regras, para não virar incômodo:
 *   - primeira visita não vê aviso: só registra a novidade mais recente;
 *   - dispensou ou clicou, some até a próxima entrada em novidades.yaml;
 *   - na própria página /novidades não aparece, só marca como vista;
 *   - sem localStorage (aba privada, bloqueio), não aparece.
 *
 * Fica oculto no HTML e o script decide se mostra. É fixo no canto, então
 * aparecer depois do carregamento não desloca o conteúdo da página.
 */
const novidades = await novidadesOrdenadas();
const ultima = novidades[0];
const ids = novidades.map((n) => n.id);
---

{
  ultima && (
    <aside
      class="aviso-novidade"
      aria-label="Novidade no guia"
      data-ids={JSON.stringify(ids)}
      hidden
    >
      <p class="rotulo">
        <span data-contagem>Novidade</span> ·{' '}
        <time datetime={dataISO(ultima.data)}>{dataCurta(ultima.data)}</time>
      </p>
      <a class="titulo" href={`/novidades/#${ultima.id}`} data-link>
        {ultima.titulo}
      </a>
      <button type="button" class="fechar" aria-label="Dispensar aviso" data-fechar>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path
            d="M6 6l12 12M18 6L6 18"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>
      </button>
    </aside>
  )
}

<script>
  const CHAVE = 'rnds:novidade-vista';

  const aviso = document.querySelector<HTMLElement>('.aviso-novidade');

  if (aviso) {
    const ids: string[] = JSON.parse(aviso.dataset.ids ?? '[]');
    const ultima = ids[0];

    /** `undefined` quando o navegador não deixa ler: aí o aviso não aparece. */
    const lerVista = (): string | null | undefined => {
      try {
        return localStorage.getItem(CHAVE);
      } catch {
        return undefined;
      }
    };

    const marcarVista = () => {
      try {
        localStorage.setItem(CHAVE, ultima);
      } catch {
        // sem armazenamento, nada a lembrar
      }
    };

    const vista = lerVista();
    const naPaginaDeNovidades = location.pathname.startsWith('/novidades');

    if (vista === null || (vista !== undefined && naPaginaDeNovidades)) {
      marcarVista();
    } else if (vista !== undefined && vista !== ultima) {
      // Posição da última vista na lista = quantas saíram depois dela.
      const pendentes = ids.indexOf(vista);
      if (pendentes > 1) {
        aviso.querySelector('[data-contagem]')!.textContent = `${pendentes} novidades`;
        aviso.querySelector<HTMLAnchorElement>('[data-link]')!.href = '/novidades/';
      }

      aviso.querySelector('[data-link]')!.addEventListener('click', marcarVista);
      aviso.querySelector('[data-fechar]')!.addEventListener('click', () => {
        marcarVista();
        aviso.hidden = true;
      });

      // O rodapé fica dentro da coluna de conteúdo, que o Starlight isola
      // (isolation: isolate). Lá dentro o z-index não vence o painel lateral
      // direito, que cobre o canto no desktop e engole os cliques. No body, o
      // aviso fica acima do painel e abaixo do menu do celular.
      document.body.append(aviso);
      aviso.hidden = false;
    }
  }
</script>

<style>
  .aviso-novidade {
    position: fixed;
    inset-block-end: 1rem;
    inset-inline-end: 1rem;
    /* Abaixo do menu mobile do Starlight (5), acima do conteúdo. */
    z-index: var(--sl-z-index-toc);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.15rem 0.75rem;
    max-width: 22rem;
    padding: 0.75rem 0.75rem 0.75rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-inline-start: 3px solid var(--sl-color-accent);
    border-radius: 0.375rem;
    background: var(--sl-color-bg-nav);
    box-shadow: var(--sl-shadow-md);
    font-size: var(--sl-text-sm);
  }

  .aviso-novidade[hidden] {
    display: none;
  }

  /* No celular ocupa a largura, com a mesma margem lateral do site. */
  @media (max-width: 30rem) {
    .aviso-novidade {
      inset-inline-start: 1rem;
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .aviso-novidade {
      animation: entrar 200ms ease-out;
    }

    @keyframes entrar {
      from {
        opacity: 0;
        transform: translateY(0.5rem);
      }
    }
  }

  .rotulo {
    grid-column: 1;
    margin: 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .titulo {
    grid-column: 1;
    color: var(--sl-color-white);
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
  }

  .titulo:hover {
    text-decoration: underline;
  }

  .fechar {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: start;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 0.25rem;
    background: transparent;
    color: var(--sl-color-gray-3);
    cursor: pointer;
  }

  .fechar:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }
</style>
